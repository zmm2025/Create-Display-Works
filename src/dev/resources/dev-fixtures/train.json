{
  "parts": {
    "alpha": "{x+10} {y} {z+1}",
    "beta": "{x+60} {y} {z+1}",
    "seat": "{x+9} {y+3} {z}",
    "controls": "{x+8} {y+3} {z}",
    "bogey": "{x+9} {y+1} {z}"
  },
  "clear": [
    "fill {x} {y} {z} {x+70} {y+4} {z+1} air"
  ],
  "steps": [
    "tp @s {x+60} {y+4} {z+3} -90 30",
    {"waitUntil": "execute if loaded {x+70} {y} {z}", "timeoutTicks": 400},
    "tp @s {x+10} {y+4} {z+3} -90 30",
    {"waitUntil": "execute if loaded {x} {y} {z}", "timeoutTicks": 400},
    "fill {x} {y} {z} {x+70} {y} {z} create:track[shape=xo]",
    {"waitTicks": 10},

    "item replace entity @s weapon.mainhand with create:track_station 2",
    {"call": "/use?x={x+10}&y={y}&z={z}&face=up&holding=create:track_station"},
    {"waitTicks": 2},
    {"call": "/use?x={x+10}&y={y-1}&z={z+1}&face=up"},
    {"waitTicks": 4},
    {"call": "/use?x={x+10}&y={y}&z={z+1}&face=up"},
    {"waitTicks": 4},
    {"call": "/click?text=Track Station"},
    {"call": "/key?key=a&mods=shortcut"},
    {"call": "/type", "body": "Alpha"},
    {"call": "/click?text=Create new Train"},
    {"waitTicks": 6},
    {"call": "/close"},
    {"waitTicks": 4},

    "tp @s {x+60} {y+4} {z+3} -90 30",
    {"waitTicks": 6},
    "item replace entity @s weapon.mainhand with create:track_station 2",
    {"call": "/use?x={x+60}&y={y}&z={z}&face=up&holding=create:track_station"},
    {"waitTicks": 2},
    {"call": "/use?x={x+60}&y={y-1}&z={z+1}&face=up"},
    {"waitTicks": 4},
    {"call": "/use?x={x+60}&y={y}&z={z+1}&face=up"},
    {"waitTicks": 4},
    {"call": "/click?text=Track Station"},
    {"call": "/key?key=a&mods=shortcut"},
    {"call": "/type", "body": "Beta"},
    {"call": "/close"},
    {"waitTicks": 4},

    "tp @s {x+9} {y+4} {z+3} 90 30",
    {"waitTicks": 6},
    "item replace entity @s weapon.mainhand with create:railway_casing",
    {"call": "/use?x={x+9}&y={y}&z={z}&face=up&holding=create:railway_casing"},
    {"waitTicks": 6},
    "fill {x+7} {y+2} {z} {x+9} {y+2} {z} create:railway_casing",
    "setblock {x+9} {y+3} {z} create:white_seat",
    "setblock {x+8} {y+3} {z} create:controls[facing=west]",
    "setblock {x+7} {y+3} {z} create:blaze_burner[blaze=smouldering]",
    "create glue {x+7} {y+1} {z} {x+9} {y+3} {z}",
    "item replace entity @s weapon.mainhand with air",
    {"call": "/use?x={x+10}&y={y}&z={z+1}&face=up&holding=minecraft:air"},
    {"waitTicks": 6},
    {"call": "/click?text=Assemble Train"},
    {"waitTicks": 10},
    {"call": "/close"},
    {"waitTicks": 4},
    {"waitUntil": "execute if entity @e[type=create:carriage_contraption,distance=..16]", "timeoutTicks": 40}
  ]
}
